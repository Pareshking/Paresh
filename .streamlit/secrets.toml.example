# Copy to `.streamlit/secrets.toml` and fill in. That filename is gitignored;
# this template is tracked, so it must never hold a real credential.
#
# Keep keys at the TOP LEVEL, not under a [section]. Streamlit exports
# top-level secrets as environment variables; anything nested under a section
# is reachable via st.secrets but is NOT exported. typesafe-sdk reads
# TYPESAFE_API_KEY from the environment, so top-level placement is what lets
# TypeSafeClient() find it with no wiring code.
#
# On Streamlit Cloud, paste the same lines into Settings -> Secrets rather
# than deploying this file.

TYPESAFE_API_KEY = ""
