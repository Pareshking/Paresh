# Copy to `.env` and fill in real values. `.env` is gitignored; this file is the
# tracked template, so it must never carry an actual credential.

# TypeSafe System One API (https://console.typesafe.ai/ to create a key).
# Read by the typesafe-sdk client automatically -- construct
# TypeSafeClient()/AsyncTypeSafeClient() with no argument and it picks this up.
# Passing the key as a literal in source is what this variable exists to avoid.
TYPESAFE_API_KEY=

# Optional, all read by the same SDK. Leave unset to take the SDK defaults;
# set only when deliberately overriding one.
# TYPESAFE_BASE_URL=
# TYPESAFE_DEFAULT_MODEL=
# TYPESAFE_LOG_LEVEL=
