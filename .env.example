# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# the tracked template, so it must never carry an actual credential.
#
# For the Streamlit app itself, prefer `.streamlit/secrets.toml` (see
# .streamlit/secrets.toml.example): Streamlit exports its top-level keys as
# environment variables on its own, and Streamlit Cloud takes the same TOML.
# This file is for everything that runs OUTSIDE Streamlit -- scripts/,
# research/, and CI -- where nothing sets the variables for you.
#
# Note that Python does not read `.env` by itself and python-dotenv is not a
# dependency here, so exporting the file is what actually applies it:
#   set -a && . ./.env && set +a

# TypeSafe System One API (create a key at https://console.typesafe.ai/).
# typesafe-sdk reads this from the environment, so TypeSafeClient() and
# AsyncTypeSafeClient() take no key argument. Never inline the key in source.
TYPESAFE_API_KEY=

# Optional, same SDK. Leave unset to take its defaults; set only to override.
# TYPESAFE_BASE_URL=
# TYPESAFE_DEFAULT_MODEL=
# TYPESAFE_LOG_LEVEL=
