{
  "about": "S173 (d). Banned synonyms: the 'Not' column of docs/GLOSSARY.md (and PAGE_DESIGN.md 3a rule 6) as patterns, read by tests/test_banned_synonyms.py against every string literal in src/ui. 'allow' holds what is there today, each with its row in docs/archive/S173_LABEL_AUDIT_2026-11-24.md; a hit is matched by file, rule and the 25 characters each side of it (whitespace collapsed), not by line. Never add an allow entry without an audit row and a reason. The rendered pages are checked by scripts/glossary_audit.mjs, whose RULES are a parallel list read off the pages; change both together.",
  "rules": [
    {"id": "G1-total-market", "glossary": 1, "pattern": "(?<!Nifty )\\bTotal Market\\b|\\bNTM\\b", "write": "Nifty Total Market"},
    {"id": "G1-the-market", "glossary": 1, "pattern": "\\bthe market(?:'s|’s)?\\b", "flags": "i", "unless_before": "Nifty (?:Total Market|\\d+|[A-Z][a-z]+)", "write": "name the index (Nifty Total Market, Nifty 500) before 'the market'"},
    {"id": "G1-market-legend", "glossary": 1, "pattern": "</i>\\s*[Mm]arket\\b", "write": "a chart legend names the index: Nifty Total Market"},
    {"id": "G2-industry", "glossary": 2, "pattern": "\\bindustr(?:y|ies)\\b", "flags": "i", "write": "sector (industry only for TradingView's split)"},
    {"id": "G3-index-short", "glossary": 3, "pattern": "(?<!Nifty )\\b(?:Smallcap|Midcap|Microcap|Largecap|LargeMidcap) ?\\d+\\b", "write": "Nifty Smallcap 250 (the short form only in an 'NSE index' column)"},
    {"id": "G3-size", "glossary": 3, "pattern": "\\b(?:Smallcap|Midcap|Largecap|Microcap)\\b(?! ?\\d)", "write": "Small Cap, Mid Cap, Large Cap, Micro Cap"},
    {"id": "G4-percentage-points", "glossary": 4, "pattern": "\\bppts?\\b|\\bpercentage points\\b", "write": "pts in figures, points in sentences (the explainer line excepted)"},
    {"id": "G5-crore", "glossary": 5, "pattern": "\\bcrores?\\b", "flags": "i", "write": "Cr"},
    {"id": "G6-one-year", "glossary": 6, "pattern": "(?<![\\w.])1Y\\b|\\b1-year\\b|\\b12-month\\b|\\bone year\\b", "flags": "i", "write": "12M in figures, 12 months in sentences"},
    {"id": "G7-since-start", "glossary": 7, "pattern": "\\bsince (?:inception|start|the record began)\\b", "flags": "i", "write": "Since 1 Jan 2026 (the system's own date)"},
    {"id": "G8-max-drawdown", "glossary": 8, "pattern": "\\b(?:its|the|a|was) max DD\\b|\\blargest fall\\b|\\bmaximum drawdown\\b|\\bworst (?:relative )?fall\\b", "flags": "i", "write": "Max DD in tables, max drawdown in sentences"},
    {"id": "G9-month-so-far", "glossary": 9, "pattern": "(?i:\\bthis month\\b|\\bmonth[- ]to[- ]date\\b)|\\bMTD\\b", "write": "Month so far · Nov"},
    {"id": "G10-sell-rule", "glossary": 10, "pattern": "\\bexit rules?\\b|\\ba hold\\b", "flags": "i", "write": "sell rule; a holding"},
    {"id": "G11-moving-average", "glossary": 11, "pattern": "\\b\\d+-day (?:average|EMA|SMA|moving average)\\b|\\b(?:50|200)-day\\b|\\bmoving average\\b|\\bDMA\\b", "flags": "i", "write": "50D EMA, 200D EMA"},
    {"id": "G11-ema-without-d", "glossary": 11, "pattern": "\\b(?:20|50|100|200) (?:EMA|SMA)\\b", "write": "50D EMA, 200D EMA, 200D SMA"}
  ],
